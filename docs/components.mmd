    Commands --> Agents
    Terminal -. implements .-> Ports

    Agents --> Models
    Agents --> Tools
    Agents --> Sessions
    Agents --> Ports
    Agents --> Conversation
    Agents --> Prompts
    Config --> Models
    Tools --> Approval
    Approval --> Security
    Approval --> Ports
    Tools --> Security

    Models --> Anthropic
    Tools --> McpServers
    Tools --> FS
    Sessions --> FS

